# Chandra OCR-2 local llama.cpp endpoint
CHANDRA_BASE_URL=http://127.0.0.1:18083
CHANDRA_MODEL=chandra-ocr-2-q8

# Gemma 4 local OpenAI-compatible endpoint
GEMMA_BASE_URL=http://127.0.0.1:3001/v1
GEMMA_MODEL=gemma4-12b
GEMMA_API_KEY=no-key

LLM_REQUEST_TIMEOUT_SECONDS=900
LLM_MAX_RETRIES=2
GEMMA_RESUME_MAX_TOKENS=8192
CHANDRA_OCR_RETRY_MAX_TOKENS=8192

PIPELINE_OUTPUT_DIR=outputs
RESUME_INPUT_DIR=inputs/resumes
JD_INPUT_DIR=inputs/jds
MATCH_OUTPUT_ROOT=outputs/matches
PIPELINE_DEBUG_RAW_RESPONSES=false
# Keep false for ordinary runs. When true, raw Chandra/Gemma model responses are persisted under ignored outputs.
ALLOW_PARTIAL_EVALUATION=false
